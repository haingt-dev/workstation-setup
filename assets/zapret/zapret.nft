#!/usr/sbin/nft -f
# zapret DPI bypass — steer the first packets of every outbound TCP 80/443 flow
# into NFQUEUE 200, where nfqws splits the TLS ClientHello / HTTP request so the
# ISP's SNI-sniffing DPI can't read the hostname (FPT Telecom injects RST otherwise).
#
# - `meta oiftype ether`  : physical ethernet/wifi only. Tunnels (tailscale0,
#                           WireGuard/AirVPN) are link/none → untouched, VPN unaffected.
# - `mark & 0x40000000`   : packets nfqws re-injects carry this mark → not re-queued.
# - `ct original packets 1-6` : only the first few packets of a flow, ~zero overhead after.
# - `bypass`              : if nfqws is down, packets pass normally instead of being dropped.
#
# "table + delete table" makes `nft -f` idempotent (atomic replace on reload).
table inet zapret
delete table inet zapret
table inet zapret {
  chain post {
    type filter hook postrouting priority mangle; policy accept;
    meta oiftype ether meta mark & 0x40000000 == 0 tcp dport { 80, 443 } ct original packets 1-6 queue num 200 bypass
  }
}
